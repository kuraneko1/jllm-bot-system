# このファイルを .env にコピーし、実値は .env だけに設定する。
# .env は Git から除外される。ここへ実際の認証情報を書かない。
DISCORD_TOKEN=replace-with-your-discord-token
DATA_DIR=data
JLLM_PROFILE=profiles/minimal.yaml

# 翻訳・会話のバックエンド既定（sarashina / local / atmos）と状態ファイルの位置。
# テスト実行時は atmos を避けること（atmos は読み上げが「辞書wavのみ」になる）。
TRANSLATION_BACKEND=sarashina
LLM_BACKEND_PATH=data/llm_backend.json
